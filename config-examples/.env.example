# BuildMax environment variables
# Almost all configuration is now in YAML config files:
#   ~/.buildmax/settings.yaml  — CLI and desktop app
#   ~/.buildmax/server.yaml    — server and worker
# See configs/settings.example.yaml and configs/server.example.yaml.
#
# Only these env vars remain:

# Path to the data directory that contains the config files above.
# Default: ~/.buildmax
# BUILDMAX_HOME=

# JWT signing secret for the server. Keep this out of files; inject at deploy time.
# Required when running buildmax-server.
BUILDMAX_JWT_SECRET=your_jwt_secret_here

# Development-only fixed login OTP; overrides dev_login_otp in server.yaml.
# When set, one fixed code logs in ANY registered email address. Unset (the
# default) disables POST /api/login, which returns 503.
# Local/trusted deployments only — never set this on an internet-facing server.
# BUILDMAX_DEV_LOGIN_OTP=123456

# Log level override (debug/info/warn/error/off).
# Overrides the log_level field in settings.yaml / server.yaml.
# BUILDMAX_LOG_LEVEL=info

# Durable run traces are on by default and written to
# <BUILDMAX_HOME>/traces/<session_id>/<run_id>.jsonl (bounded + redacted).
# Set to a truthy value (1/true/yes/on) to disable them.
# BUILDMAX_TRACE_DISABLED=

# ---------------------------------------------------------------------------
# Fallback LLM config for CLI/desktop when settings.yaml has no models.
# Prefer configuring models in settings.yaml instead.
# ---------------------------------------------------------------------------
# BUILDMAX_API_KEY=your_key_here
# BUILDMAX_BASE_URL=https://openrouter.ai/api/v1
# BUILDMAX_MODEL=google/gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Development and test only
# ---------------------------------------------------------------------------
# BUILDMAX_KIND_CLUSTER=buildmaxdev
# BUILDMAX_IMAGE_PLATFORM=linux/amd64
# BUILDMAX_TEST_DSN=buildmax:buildmax@tcp(localhost:3306)/buildmax?charset=utf8mb4&parseTime=True
