{
  "name": "@buildmax/gui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./modal.css": "./dist/modal.css",
    "./widgets.css": "./dist/widgets.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  },
  "scripts": {
    "build": "vite build && cp src/theme.css dist/theme.css && cp src/modal.css dist/modal.css && cp src/widgets.css dist/widgets.css && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --rootDir src",
    "dev": "vite build --watch"
  },
  "files": [
    "dist"
  ]
}
