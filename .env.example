# Optional personal credentials used by repository developer and operator tasks.
#
# Copy this file to .env, fill only the credentials you use, and keep the
# resulting file private:
#
#   cp .env.example .env
#   chmod 600 .env

# GitHub API access used by local tooling that talks to GitHub.
GITHUB_TOKEN=

# DigitalOcean external-infrastructure qualification.
DIGITALOCEAN_TOKEN=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
