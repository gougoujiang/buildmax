# BuildMax environment variables
# Copy to .env and fill in your keys (.env is gitignored).
# Full list and defaults: internal/config/env_spec.go (EnvVars).
#
# To load in terminal:
#   CMD:        call loadenv.bat
#   PowerShell: . .\loadenv.ps1

# -----------------------------------------------------------------------------
# LLM / API (required for prompt mode and agent)
# -----------------------------------------------------------------------------
# API key for OpenAI-compatible / OpenRouter API
BUILDMAX_API_KEY=your_key_here

# Base URL (default: OpenRouter). Unset = use OpenRouter.
# BUILDMAX_BASE_URL=https://openrouter.ai/api/v1

# Model (default: openai/gpt-3.5-turbo or project default)
# BUILDMAX_MODEL=openai/gpt-3.5-turbo

# -----------------------------------------------------------------------------
# Application data (optional)
# -----------------------------------------------------------------------------
# Data directory; default ~/.buildmax. make test uses testing-sandbox.
# BUILDMAX_HOME=

# Parent of workspace roots (required for server mode; no default).
# BUILDMAX_WORKSPACES_DIR=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: debug, info, warn, error, off (default: info)
# BUILDMAX_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HTTP server (buildmax server — backend for portal)
# -----------------------------------------------------------------------------
# Port to listen on; default 5678. Can override with --port.
# BUILDMAX_SERVER_PORT=5678

# Required for server: JWT signing secret for auth tokens.
BUILDMAX_JWT_SECRET=your_jwt_secret_here

# CORS allowed origin for portal; default http://localhost:5173
# BUILDMAX_CORS_ORIGIN=http://localhost:5173

# Worker (buildmax-worker binary; required for /api/worker/* and when server runs tasks)
# BUILDMAX_WORKER_BINARY=buildmax-worker
# BUILDMAX_SERVER_URL=http://localhost:5678
# BUILDMAX_WORKER_TOKEN=your_worker_token_here

# -----------------------------------------------------------------------------
# Database / MySQL (used by server for store)
# -----------------------------------------------------------------------------
BUILDMAX_DB_HOST=localhost
BUILDMAX_DB_PORT=3306
BUILDMAX_DB_USER=buildmax
BUILDMAX_DB_PASSWORD=buildmax
BUILDMAX_DB_DATABASE=buildmax

# For local Docker MySQL only (not used by Go app)
# BUILDMAX_DB_ROOT_PASSWORD=buildmax

# -----------------------------------------------------------------------------
# Workspace storage (persist & artifacts)
# -----------------------------------------------------------------------------
# Persist: local_fs | minio (default: local_fs)
# BUILDMAX_PERSIST_STORAGE=local_fs

# Artifact: local_fs | minio (default: local_fs)
# BUILDMAX_ARTIFACT_STORAGE=local_fs

# MinIO/S3 (when either storage is minio)
# BUILDMAX_MINIO_ENDPOINT=http://localhost:9000
# BUILDMAX_MINIO_REGION=us-east-1
# BUILDMAX_MINIO_ACCESS_KEY=minio
# BUILDMAX_MINIO_SECRET_KEY=minio123
# BUILDMAX_MINIO_BUCKET=bmstore
# BUILDMAX_MINIO_PREFIX=workspaces

# -----------------------------------------------------------------------------
# Optional / external
# -----------------------------------------------------------------------------
# GitHub token (e.g. for API or integrations)
# GITHUB_TOKEN=your_token_here

# Kind cluster name for setup scripts (default: buildmaxdev)
# BUILDMAX_KIND_CLUSTER=buildmaxdev

# Test only: MySQL DSN for store integration tests; unset skips those tests.
# BUILDMAX_TEST_DSN=buildmax:buildmax@tcp(localhost:3306)/buildmax?charset=utf8mb4&parseTime=True
