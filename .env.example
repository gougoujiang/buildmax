# Copy to .env and fill in your keys ( .env is gitignored )
OPENROUTER_API_KEY=your_key_here
GITHUB_TOKEN=your_token_here

# Docker Compose (local dev) - optional; defaults work out of the box
# MYSQL_ROOT_PASSWORD=buildmax_dev
# MYSQL_DATABASE=buildmax
# MYSQL_USER=buildmax
# MYSQL_PASSWORD=buildmax_dev

# To load in terminal:
#   CMD:        call loadenv.bat
#   PowerShell: . .\loadenv.ps1
