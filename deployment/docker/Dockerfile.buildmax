# BuildMax binary — multi-stage build for Linux (kind/K8s).
# Build inputs: go.mod, go.sum, cmd/, internal/ only.
#
# The build context is the repository root, not this directory:
#
#   docker build -f deployment/docker/Dockerfile.buildmax -t buildmax:local .
#
# ./make kind images does that for you.

# Stage 1: build
FROM golang:1.26-alpine3.23 AS build
WORKDIR /app

COPY go.mod go.sum ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 go build -o /buildmax ./cmd/buildmax && \
    CGO_ENABLED=0 go build -o /buildmax-server ./cmd/buildmax-server && \
    CGO_ENABLED=0 go build -o /buildmax-worker ./cmd/buildmax-worker

# Stage 2: runtime
FROM alpine:3.23
# bubblewrap + socat are the Linux sandbox backend buildmax-worker resolves to
# once agentapp/taskrun selects config.SandboxSurfaceWorker (see
# docs/design/sandbox-boundaries.md §7.2). The worker baseline sets
# fail_if_unavailable: true, so a worker image missing either package refuses
# every run rather than executing model-chosen shell commands unconfined.
RUN apk add --no-cache ca-certificates bubblewrap socat

COPY --from=build /buildmax /usr/local/bin/buildmax
COPY --from=build /buildmax-server /usr/local/bin/buildmax-server
COPY --from=build /buildmax-worker /usr/local/bin/buildmax-worker
ENTRYPOINT ["/usr/local/bin/buildmax"]
