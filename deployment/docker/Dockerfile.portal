# BuildMax Portal — React/Vite static build, served by nginx.
#
# The build context is the repository root, not this directory.
#
# Build: docker build -f deployment/docker/Dockerfile.portal -t buildmax-portal:local .
# Run:   docker run -p 8080:80 -e BUILDMAX_API_BASE=http://localhost:5678 buildmax-portal:local
#
# The published image is ghcr.io/gougoujiang/buildmax-portal, built by
# .github/workflows/portal-image.yml. See docs/deploy/overview.md.

# Stage 1: build.
#
# --platform=$BUILDPLATFORM pins this stage to the machine doing the building
# rather than the image's target architecture. The output is static JavaScript
# and CSS, identical on every platform, so emulating arm64 to run npm would cost
# minutes per build and produce the same bytes.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app

# Build the shared gui package first so portal's local file dependency
# resolves with generated dist assets and type declarations.
COPY gui/package.json gui/package-lock.json /app/gui/
WORKDIR /app/gui
RUN npm ci
COPY gui/ /app/gui/
RUN npm run build

WORKDIR /app/portal
COPY portal/package.json portal/package-lock.json /app/portal/
RUN npm ci
COPY portal/ /app/portal/
RUN npm run build

# Stage 2: serve.
FROM nginx:alpine
COPY --from=build /app/portal/dist /usr/share/nginx/html
COPY portal/nginx-default.conf /etc/nginx/conf.d/default.conf

# nginx's own entrypoint runs everything in this directory before starting, so
# the API URL is applied at container start instead of being baked into the
# bundle. Without it a published image could only ever talk to one server.
COPY portal/docker-entrypoint.d/20-buildmax-config.sh /docker-entrypoint.d/20-buildmax-config.sh
RUN chmod +x /docker-entrypoint.d/20-buildmax-config.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
