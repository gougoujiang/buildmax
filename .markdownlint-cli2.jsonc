{
  "config": {
    "MD004": {
      "style": "dash"
    },
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    // The portal build mirrors the repository-root manual into portal/public/help
    // so Vite bundles it (portal/scripts/sync-manual.mjs). It is generated and
    // gitignored; manual/ is the source these rules already lint.
    "portal/public/help/**",
    // Playwright writes a Markdown failure report per failed test. It is
    // generated, gitignored, and only present after someone runs `./make e2e`
    // locally — without this, a failed browser test also fails `check docs`.
    "**/test-results/**",
    // Same category: the virtualenv `uv run` builds to run the Harbor
    // adapter's Python tests. It is gitignored and holds every dependency's
    // own README, so without this a contributor who ran those tests fails
    // `check docs` on third-party markdown.
    "**/.venv/**",
    ".buildmax/**",
    // Agent scratch state: git-ignored worktrees and their test output, which
    // is generated markdown nobody edits and every generator formats its own way.
    ".claude/**",
    // Same category: local agent notes AGENTS.md says never to commit, and the
    // release notes and end-to-end evidence `./make` generates into .artifacts.
    ".vibe/**",
    ".artifacts/**",
    // Same category: the README `./make setup local` writes into a contributor's
    // own gitignored config directory. It is generated, not edited, so linting it
    // would fail `check docs` on a file nobody can fix in the repository.
    ".local/**",
    "docs/design/**",
    // The Chinese design mirror is checked for completeness, links, and
    // synchronization by the architecture tests. English Markdown style
    // rules (list numbering, punctuation, and emphasis spacing) do not map
    // reliably to translated Chinese prose.
    "docs/zh-CN/design/**",
    "testing-sandbox/**",
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
