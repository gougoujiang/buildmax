{
  "config": {
    "MD004": {
      "style": "dash"
    },
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    // Playwright writes a Markdown failure report per failed test. It is
    // generated, gitignored, and only present after someone runs `./make e2e`
    // locally — without this, a failed browser test also fails `check docs`.
    "**/test-results/**",
    ".buildmax/**",
    // Agent scratch state: git-ignored worktrees and their test output, which
    // is generated markdown nobody edits and every generator formats its own way.
    ".claude/**",
    "docs/design/**",
    "eval/**",
    "testing-sandbox/**",
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
