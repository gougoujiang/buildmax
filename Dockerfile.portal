# BuildMax Portal — React/Vite static build, served by nginx.
# Build: docker build -f Dockerfile.portal -t buildmax-portal:local .
# Run:   docker run -p 8080:80 buildmax-portal:local

# Stage 1: build
FROM node:20-alpine AS build
WORKDIR /app

COPY portal/package.json portal/package-lock.json ./
RUN npm ci

COPY portal/ .
RUN npm run build

# Stage 2: serve
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY portal/nginx-default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
