{
  "contract_version": 1,
  "id": "worker-report-from-space-files",
  "version": 1,
  "suite": "worker-and-taskrun",
  "title": "Produce a report from the space's files in a worker run",
  "tags": ["worker", "materialization", "output"],
  "domain": "product_outcome",
  "surface": "worker",
  "turns": [
    "The space's files are in your working directory. Read backlog.md and write summary.md there, listing how many items are open and naming the one marked urgent."
  ],
  "limits": {
    "wall_seconds": 240,
    "tool_calls": 40
  },
  "trials": 3,
  "graders": [
    {
      "name": "files",
      "version": 1,
      "kind": "deterministic",
      "required": true,
      "config": { "exists": ["summary.md", "backlog.md"] }
    },
    {
      "name": "command",
      "version": 1,
      "kind": "deterministic",
      "required": true,
      "config": { "run": ["./check-summary.sh"], "timeout_seconds": 30 }
    },
    {
      "name": "trace",
      "version": 1,
      "kind": "trace",
      "required": true,
      "config": { "required_tools": ["Write"], "max_tool_calls": 40 }
    }
  ],
  "oracle": ["sh", "./solve.sh"]
}
