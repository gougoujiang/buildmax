{
  "openapi": "3.0.3",
  "info": {
    "title": "BuildMax API",
    "version": "0.0.7"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Agent": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "user_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "instructions": { "type": "string" },
          "created_at": { "type": "integer" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "conversation_id": { "type": "string" },
          "session_id": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "input": { "type": "string" },
          "title": { "type": "string" },
          "output": { "type": "string", "nullable": true },
          "created_by": { "type": "string" },
          "created_at": { "type": "integer" },
          "started_at": { "type": "integer", "nullable": true },
          "ended_at": { "type": "integer", "nullable": true },
          "error_message": { "type": "string", "nullable": true },
          "agent_id": { "type": "string", "nullable": true }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "user_id": { "type": "string" },
          "channel": { "type": "string" },
          "title": { "type": "string" },
          "created_at": { "type": "integer" },
          "created_by": { "type": "string" }
        }
      },
      "ConversationMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "content": { "type": "string" },
          "channel": { "type": "string", "nullable": true },
          "created_at": { "type": "integer" }
        }
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "task_run_id": { "type": "string" },
          "task_id": { "type": "string" },
          "conversation_id": { "type": "string" },
          "user_id": { "type": "string" },
          "created_at": { "type": "integer" },
          "task_input_snippet": { "type": "string" }
        }
      },
      "ArtifactItem": {
        "type": "object",
        "properties": {
          "relative_path": { "type": "string" }
        }
      },
      "FileNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["folder", "file"] },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FileNode" }
          }
        }
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ready", "unavailable"] },
          "checks": {
            "type": "array",
            "description": "Every dependency probed. An empty array means nothing was verified.",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "Which dependency, never where it lives" },
                "status": { "type": "string", "enum": ["ok", "failed"] }
              }
            }
          }
        }
      },
      "TraceBoundary": {
        "type": "object",
        "properties": {
          "sandboxed": { "type": "boolean", "description": "False means nothing confined the run's Bash commands" },
          "mode": { "type": "string" },
          "backend": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Layer chain that decided the boundary, e.g. default:worker, settings, policy"
          },
          "downgraded": { "type": "boolean" }
        }
      },
      "TraceToolCall": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "path": { "type": "string", "description": "The call's file_path argument, when it had one" },
          "denied": { "type": "boolean" },
          "deny_reason": { "type": "string" }
        }
      },
      "TaskRunTrace": {
        "type": "object",
        "properties": {
          "task_run_id": { "type": "string" },
          "run_id": { "type": "string", "description": "Agent run id; also the trace file's name" },
          "model": { "type": "string" },
          "started_at": { "type": "string" },
          "ended_at": { "type": "string" },
          "boundary": { "$ref": "#/components/schemas/TraceBoundary" },
          "llm_calls": { "type": "integer" },
          "tool_calls": { "type": "integer" },
          "compactions": { "type": "integer" },
          "prompt_tokens": { "type": "integer" },
          "completion_tokens": { "type": "integer" },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TraceToolCall" }
          },
          "tools_truncated": { "type": "boolean", "description": "The tools list was bounded; tool_calls still counts them all" },
          "files_changed": { "type": "array", "items": { "type": "string" } },
          "error": { "type": "string", "description": "Terminal error; empty when the run succeeded" },
          "complete": { "type": "boolean", "description": "False means the run wrote no terminal record — do not read as success" }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness check",
        "description": "Reports that the process is running. Checks no dependencies by design — a liveness probe that failed on a dependency outage would restart a healthy server.",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness check",
        "description": "Reports whether the server can serve traffic, probing each configured dependency. Names the failing check but never the reason, which goes to the server log: this endpoint is unauthenticated and connection errors carry DSNs and endpoints.",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          }
        }
      }
    },
    "/api/otp/request": {
      "post": {
        "summary": "Request OTP",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login",
        "description": "Accepts either a `password` (the everyday credential) or a single-use `otp` login code (the recovery path, issued by an operator). Returns an access token and, when the deployment stores them, a refresh token. `token` repeats `access_token` under the name it had before the two were split.",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/password": {
      "post": {
        "summary": "Set or change the caller's password",
        "description": "Requires the current password when the account already has one: a session by itself must not be enough, since an access token cannot be revoked before it expires. Setting the first password after signing in with a login code needs no current password.",
        "responses": {
          "204": { "description": "Password set" },
          "400": { "description": "New password fails the length rule, or body invalid" },
          "401": { "description": "Not authenticated, or the current password is wrong" },
          "503": { "description": "Deployment has no password store" }
        }
      }
    },
    "/api/token/refresh": {
      "post": {
        "summary": "Exchange a refresh token for a new token pair",
        "description": "Unauthenticated: possession of the refresh token is the proof. Each exchange spends the token presented and returns its replacement in the same session. Presenting a spent token past `refresh_rotation_grace` revokes the whole session.",
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "refresh_token missing, or body invalid" },
          "401": { "description": "Token unknown, expired, revoked, or reused" },
          "503": { "description": "Deployment has no refresh token store" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Revoke one session",
        "description": "Accepts either credential: a refresh_token in the body names its session, otherwise the session comes from the access token's sid claim. Revoking a session the server has already forgotten is a success.",
        "responses": {
          "204": { "description": "Session revoked, or already gone" },
          "401": { "description": "Neither credential supplied" },
          "503": { "description": "Deployment has no refresh token store" }
        }
      }
    },
    "/api/usage": {
      "get": {
        "summary": "Get current user usage",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/teams/{team_id}/llm/models": {
      "get": {
        "summary": "List the model aliases this team may use",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "No model is available to this team" },
          "503": { "description": "Managed inference is not configured" }
        }
      }
    },
    "/api/worker/task-runs/{task_run_id}/llm/completions": {
      "post": {
        "summary": "Run one managed model call on behalf of a task run, so a worker needs no upstream provider credential. Authenticated with the run token the scheduler minted for that run: user, team, task, and run all come from the credential, never from the request",
        "parameters": [
          { "name": "task_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK. Same body and streaming behaviour as the team route" },
          "400": { "description": "Invalid request, unknown field, or a model the run's team may not use" },
          "401": { "description": "Missing, invalid, or expired run token" },
          "403": { "description": "The run token authorizes a different task run, or a different team than the run's" },
          "404": { "description": "No such task run" },
          "409": { "description": "The run is not executing, so no call is accepted for it" },
          "429": { "description": "Team quota exceeded" }
        }
      }
    },
    "/api/teams/{team_id}/llm/completions": {
      "post": {
        "summary": "Run one managed model call. Names a team alias; upstream endpoints, credentials, and provider model identifiers are never accepted or returned. With stream=true the response is text/event-stream carrying delta, result, and error events",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK. A streamed call that fails after its first delta still answers 200 and reports the failure as an error event" },
          "400": { "description": "Invalid request, unknown field, or a model the team may not use" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "No model is available to this team" },
          "409": { "description": "This call_id has already been used by the team" },
          "429": { "description": "Team quota exceeded" },
          "502": { "description": "The model provider failed" },
          "503": { "description": "Managed inference is not configured" }
        }
      }
    },
    "/api/teams/{team_id}/agents": {
      "get": {
        "summary": "List agents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Agent" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create agent",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Agent" }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/agents/{agent_id}": {
      "get": {
        "summary": "Get agent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "agent_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Agent" }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update agent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "agent_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Agent" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete agent",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "agent_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "No Content" }
        }
      }
    },
    "/api/teams/{team_id}/files": {
      "get": {
        "summary": "List team files",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "team_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FileNode" }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/files/{path}": {
      "get": {
        "summary": "Get file content",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "team_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/teams/{team_id}/upload": {
      "post": {
        "summary": "Upload files",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "team_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/webhook-keys": {
      "get": {
        "summary": "List webhook keys",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "summary": "Create webhook key",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/webhook-keys/{key_id}": {
      "delete": {
        "summary": "Delete webhook key",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "key_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "No Content" }
        }
      }
    },
    "/api/webhook": {
      "post": {
        "summary": "Trigger webhook",
        "description": "Authenticated with Authorization: Bearer <webhook key> or X-Webhook-Key.",
        "responses": {
          "202": { "description": "Accepted" }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "summary": "List conversations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversations": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Conversation" }
                    },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create conversation",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/api/teams/{team_id}/conversations/{conversation_id}/messages": {
      "get": {
        "summary": "List conversation messages",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ConversationMessage" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Append conversation message",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/teams/{team_id}/conversations/{conversation_id}/tasks": {
      "get": {
        "summary": "List tasks in a conversation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create task in a conversation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}": {
      "get": {
        "summary": "Get task",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/runs": {
      "post": {
        "summary": "Create task run",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "Created" },
          "409": { "description": "Run already in progress" }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/cancel": {
      "post": {
        "summary": "Cancel the task's run",
        "description": "A run that has not been dispatched is canceled outright and answers 200. A run a worker already holds is asked to stop and answers 202; it reaches CANCELED when that worker confirms, or when the server's backstop finishes it.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Canceled" },
          "202": { "description": "Cancel requested; the run's worker is stopping it" },
          "409": { "description": "No run in progress, or it already finished" }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/retry": {
      "post": {
        "summary": "Run the task's last run again",
        "description": "Creates a new run with the same input as the task's most recent finished run, recording which run it repeats. Takes no body. A task whose run is still in flight, one that has never finished a run, and one belonging to a workflow step all answer 409.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": {
            "description": "Retry created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": { "type": "string" },
                    "task_run_id": { "type": "string" },
                    "retry_of_task_run_id": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "409": { "description": "A run is in progress, there is no finished run to retry, or the task belongs to a workflow step" }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/conversation": {
      "get": {
        "summary": "Get task execution conversation",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/stream": {
      "get": {
        "summary": "Stream task run output",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/teams/{team_id}/tasks/{task_id}/artifacts": {
      "get": {
        "summary": "List artifacts for a task",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Artifact" }
                }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/task-runs/{task_run_id}/artifacts/items": {
      "get": {
        "summary": "List artifact files for a task run",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ArtifactItem" }
                }
              }
            }
          }
        }
      }
    },
    "/api/teams/{team_id}/task-runs/{task_run_id}/artifacts/content": {
      "get": {
        "summary": "Get artifact file content",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_run_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/teams/{team_id}/task-runs/{task_run_id}/trace": {
      "get": {
        "summary": "Get a task run's trace summary",
        "description": "What the run used, touched, spent, why it ended, and the execution boundary it ran under. Model output, tool arguments, and tool results are deliberately excluded.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskRunTrace" }
              }
            }
          },
          "404": { "description": "The run recorded no trace, or its trace is no longer in storage" }
        }
      }
    },
    "/api/teams/{team_id}/task-runs/{task_run_id}/llm-calls": {
      "get": {
        "summary": "List a task run's managed model calls",
        "description": "What the run spent and on which approved alias, oldest first. An accounting record, not a transcript: prompts, tool arguments, and generated content are absent, and so is the catalog entry the alias resolved to, which is the operator's routing rather than the team's.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "task_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK. An empty array when the run made no managed calls, which is what a direct-mode run does" },
          "404": { "description": "No such run for this team" },
          "503": { "description": "This deployment records no managed calls" }
        }
      }
    }
  }
}
