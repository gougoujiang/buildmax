      "get": {
        "summary": "Get chat run (worker)",
        "description": "Returns the chat run and chat for the worker. Requires worker Bearer token (BUILDMAX_WORKER_TOKEN).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "chat_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
