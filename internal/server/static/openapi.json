        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "chat_run_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
