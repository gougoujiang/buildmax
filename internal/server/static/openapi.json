                    "run": {
                      "type": "object",
                      "properties": {
                        "chat_run_id": { "type": "string" },
                        "chat_id": { "type": "string" },
                        "input": { "type": "string" },
                        "status": { "type": "string" },
                        "created_at": { "type": "integer" }
