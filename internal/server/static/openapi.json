{
  "openapi": "3.0.3",
  "info": { "title": "BuildMax API", "version": "0.0.5" },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FileNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["folder", "file"] },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FileNode" }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "description": "Returns 200 when the server is alive.",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/otp/request": {
      "post": {
        "summary": "Request OTP",
        "description": "Request OTP for signup or login. For signup: creates user if email is new, returns 409 if email already registered. For login: returns 404 if user not found. On success returns 200 with message otp_sent (no real email sent in MVP).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string" },
                  "intent": { "type": "string", "enum": ["signup", "login"], "description": "signup or login; default signup" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "400": { "description": "Invalid request body or empty email" },
          "404": { "description": "User not found (login intent)" },
          "409": { "description": "Email already registered (signup intent)" },
          "503": { "description": "OTP not configured" }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate by email and OTP. Returns JWT and user info on success. MVP uses hardcoded OTP.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "email": { "type": "string" },
                        "name": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid request body, email or otp required" },
          "401": { "description": "User not found or invalid otp" }
        }
      }
    },
    "/api/usage": {
      "get": {
        "summary": "Get current user usage",
        "description": "Returns usage and tier limits for the authenticated user (rolling window). Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "run_count": { "type": "integer" },
                    "total_tokens": { "type": "integer" },
                    "tier": { "type": "string" },
                    "period_days": { "type": "integer" },
                    "max_runs_per_period": { "type": "integer" },
                    "max_tokens_per_period": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "503": { "description": "Usage not available (quota not configured)" }
        }
      }
    },
    "/api/workspaces": {
      "get": {
        "summary": "List workspaces",
        "description": "Returns workspaces for the authenticated user. Creates a Default workspace if none exist. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "owner_user_id": { "type": "string" },
                      "created_at": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create workspace",
        "description": "Creates a workspace for the authenticated user. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "owner_user_id": { "type": "string" },
                    "created_at": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (name missing)" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/chats": {
      "get": {
        "summary": "List chats",
        "description": "Returns chats in the workspace. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "status": { "type": "string" },
                      "input": { "type": "string" },
                      "title": { "type": "string", "description": "Short display title (generated or truncated from input)" },
                      "output": { "type": "string", "nullable": true },
                      "created_by": { "type": "string" },
                      "created_at": { "type": "integer" },
                      "started_at": { "type": "integer", "nullable": true },
                      "ended_at": { "type": "integer", "nullable": true },
                      "error_message": { "type": "string", "nullable": true },
                      "agent_id": { "type": "string", "nullable": true, "description": "When set, chat was created from this workspace agent" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "503": { "description": "Chats not configured" }
        }
      },
      "post": {
        "summary": "Create chat",
        "description": "Creates a chat in the workspace. Caller must own the workspace. Requires Bearer JWT. When agent_id is provided, input is optional and the stored input is composed from the agent (name, description, instructions); when agent_id is absent, input is required.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": { "type": "string", "description": "Required when agent_id is absent; optional when agent_id is present (appended to agent block)" },
                  "agent_id": { "type": "string", "description": "Optional. When set, must be a valid agent in the same workspace; stored input is composed from the agent" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "workspace_id": { "type": "string" },
                    "status": { "type": "string" },
                    "input": { "type": "string" },
                    "title": { "type": "string", "description": "Short display title (generated or truncated from input)" },
                    "output": { "type": "string", "nullable": true },
                    "created_by": { "type": "string" },
                    "created_at": { "type": "integer" },
                    "started_at": { "type": "integer", "nullable": true },
                    "ended_at": { "type": "integer", "nullable": true },
                    "error_message": { "type": "string", "nullable": true },
                    "agent_id": { "type": "string", "nullable": true, "description": "When set, chat was created from this workspace agent" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (input missing when agent_id absent, or agent not found / not in workspace)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "429": { "description": "Quota exceeded (run or token limit)" },
          "503": { "description": "Chats not configured, or agents not configured (when agent_id is sent)" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts": {
      "get": {
        "summary": "List artifacts",
        "description": "Returns artifacts in the workspace. Optional query param chat_id filters results. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_id", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter by chat" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chat_run_id": { "type": "string" },
                      "chat_id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "created_at": { "type": "integer" },
                      "chat_input_snippet": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts/{chat_run_id}/items": {
      "get": {
        "summary": "List run output items",
        "description": "Returns the list of output files for a chat run. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_run_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Chat run id (run output id)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "relative_path": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "chat_run_id required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Run output not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts/{chat_run_id}/content": {
      "get": {
        "summary": "Get run output content",
        "description": "Returns raw file content for a chat run output. Optional query param path (default result.md). Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_run_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Chat run id (run output id)" },
          { "name": "path", "in": "query", "required": false, "schema": { "type": "string" }, "description": "File path relative to run output (default result.md)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Run output or file not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/upload": {
      "post": {
        "summary": "Upload files",
        "description": "Upload one or more files to the workspace persist storage. Multipart form: files (required), optional paths[] for directory upload. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["files"],
                "properties": {
                  "files": { "type": "array", "items": { "type": "string", "format": "binary" } },
                  "paths": { "type": "array", "items": { "type": "string" }, "description": "Relative paths; count must match files" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uploaded": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "400": { "description": "No files or invalid form" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/files": {
      "get": {
        "summary": "List workspace files (tree)",
        "description": "Returns the full directory tree of persisted files in the workspace. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["folder", "file"] },
                    "children": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FileNode" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/files/{path}": {
      "get": {
        "summary": "Get file content",
        "description": "Returns raw file content for a path in the workspace persist storage. Path is relative to workspace root. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Relative file path (may contain slashes)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "File path required or invalid" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "File not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/chats/{chat_id}/runs": {
      "post": {
        "summary": "Create chat run",
        "description": "Starts a run for the chat. Returns chat_run_id and chat_id. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input"],
                "properties": {
                  "input": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chat_run_id": { "type": "string" },
                    "chat_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (input or chat_id missing)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Chat not found" },
          "429": { "description": "Quota exceeded (run or token limit)" },
          "503": { "description": "Chats not configured" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/chats/{chat_id}/stream": {
      "get": {
        "summary": "Stream chat output",
        "description": "Server-Sent Events stream of the chat's current run assistant output (user-facing; no run_id). Returns existing buffer (if any), then live deltas, then a \"done\" event when the run completes. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "SSE stream (Content-Type: text/event-stream). Events: delta (data: text), done.",
            "content": {
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "chat_id required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Chat not found" },
          "503": { "description": "Stream not available" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/chats/{chat_id}/conversation": {
      "get": {
        "summary": "Get chat conversation",
        "description": "Returns the agent conversation for the chat. Session is an implementation detail; the chat stores session_id when run. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "chat_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "created_at": { "type": "string" },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": { "type": "string" },
                          "content": { "type": "string" },
                          "tool_call_id": { "type": "string" },
                          "tool_calls": { "type": "array" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "chat_id required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Chat or conversation not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/agents": {
      "get": {
        "summary": "List agents",
        "description": "Returns workspace-scoped agents (personas). Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "instructions": { "type": "string" },
                      "created_at": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "503": { "description": "Agents not configured" }
        }
      },
      "post": {
        "summary": "Create agent",
        "description": "Creates a workspace-scoped agent. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "instructions": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "workspace_id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "instructions": { "type": "string" },
                    "created_at": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (name required)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "503": { "description": "Agents not configured" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/agents/{agent_id}": {
      "get": {
        "summary": "Get agent",
        "description": "Returns one workspace-scoped agent. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "agent_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "workspace_id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "instructions": { "type": "string" },
                    "created_at": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "agent_id required" },
          "401": { "description": "Unauthorized" },
