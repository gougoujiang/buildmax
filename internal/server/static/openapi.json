{
  "openapi": "3.0.3",
  "info": { "title": "BuildMax API", "version": "0.0.5" },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FileNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["folder", "file"] },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FileNode" }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "description": "Returns 200 when the server is alive.",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/otp/request": {
      "post": {
        "summary": "Request OTP",
        "description": "Request OTP for signup or login. For signup: creates user if email is new, returns 409 if email already registered. For login: returns 404 if user not found. On success returns 200 with message otp_sent (no real email sent in MVP).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string" },
                  "intent": { "type": "string", "enum": ["signup", "login"], "description": "signup or login; default signup" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "400": { "description": "Invalid request body or empty email" },
          "404": { "description": "User not found (login intent)" },
          "409": { "description": "Email already registered (signup intent)" },
          "503": { "description": "OTP not configured" }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate by email and OTP. Returns JWT and user info on success. MVP uses hardcoded OTP.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string" },
                  "otp": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "email": { "type": "string" },
                        "name": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid request body, email or otp required" },
          "401": { "description": "User not found or invalid otp" }
        }
      }
    },
    "/api/workspaces": {
      "get": {
        "summary": "List workspaces",
        "description": "Returns workspaces for the authenticated user. Creates a Default workspace if none exist. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "owner_user_id": { "type": "string" },
                      "created_at": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create workspace",
        "description": "Creates a workspace for the authenticated user. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "owner_user_id": { "type": "string" },
                    "created_at": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (name missing)" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/projects": {
      "get": {
        "summary": "List projects",
        "description": "Returns projects for the given workspace. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "created_at": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden (workspace not owned)" }
        }
      },
      "post": {
        "summary": "Create project",
        "description": "Creates a project under the given workspace. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "workspace_id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "created_at": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (name missing)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/tasks": {
      "get": {
        "summary": "List tasks",
        "description": "Returns tasks in the workspace. Optional query param project_id filters by project. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "project_id", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter tasks by project" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "project_id": { "type": "string", "nullable": true },
                      "status": { "type": "string" },
                      "input": { "type": "string" },
                      "title": { "type": "string", "description": "Short display title (generated or truncated from input)" },
                      "output": { "type": "string", "nullable": true },
                      "created_by": { "type": "string" },
                      "created_at": { "type": "integer" },
                      "started_at": { "type": "integer", "nullable": true },
                      "ended_at": { "type": "integer", "nullable": true },
                      "error_message": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (project does not belong to workspace)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Project not found (when project_id query is given)" },
          "503": { "description": "Tasks not configured" }
        }
      },
      "post": {
        "summary": "Create task",
        "description": "Creates a task in the workspace. Optional project_id in body links the task to a project (must belong to the same workspace). Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input"],
                "properties": {
                  "input": { "type": "string" },
                  "project_id": { "type": "string", "description": "Optional project to associate the task with" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "workspace_id": { "type": "string" },
                    "project_id": { "type": "string", "nullable": true },
                    "status": { "type": "string" },
                    "input": { "type": "string" },
                    "title": { "type": "string", "description": "Short display title (generated or truncated from input)" },
                    "output": { "type": "string", "nullable": true },
                    "created_by": { "type": "string" },
                    "created_at": { "type": "integer" },
                    "started_at": { "type": "integer", "nullable": true },
                    "ended_at": { "type": "integer", "nullable": true },
                    "error_message": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request (input missing or project does not belong to workspace)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Project not found (when project_id is given)" },
          "503": { "description": "Tasks not configured" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts": {
      "get": {
        "summary": "List artifacts",
        "description": "Returns artifacts in the workspace. Optional query params task_id and project_id filter results. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "task_id", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter by task" },
          { "name": "project_id", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Filter by project" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "artifact_id": { "type": "string" },
                      "task_id": { "type": "string" },
                      "workspace_id": { "type": "string" },
                      "project_id": { "type": "string", "nullable": true },
                      "created_at": { "type": "integer" },
                      "seq": { "type": "integer" },
                      "task_input_snippet": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts/{artifact_id}/items": {
      "get": {
        "summary": "List artifact items",
        "description": "Returns the list of files (items) for an artifact. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "artifact_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "relative_path": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "artifact_id required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Artifact not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/artifacts/{artifact_id}/content": {
      "get": {
        "summary": "Get artifact content",
        "description": "Returns raw file content for an artifact. Optional query param path (default result.md). Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "artifact_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "query", "required": false, "schema": { "type": "string" }, "description": "File path relative to artifact (default result.md)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Artifact or file not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/upload": {
      "post": {
        "summary": "Upload files",
        "description": "Upload one or more files to the workspace persist storage. Multipart form: files (required), optional paths[] for directory upload. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["files"],
                "properties": {
                  "files": { "type": "array", "items": { "type": "string", "format": "binary" } },
                  "paths": { "type": "array", "items": { "type": "string" }, "description": "Relative paths; count must match files" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uploaded": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "400": { "description": "No files or invalid form" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/files": {
      "get": {
        "summary": "List workspace files (tree)",
        "description": "Returns the full directory tree of persisted files in the workspace. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["folder", "file"] },
                    "children": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FileNode" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/files/{path}": {
      "get": {
        "summary": "Get file content",
        "description": "Returns raw file content for a path in the workspace persist storage. Path is relative to workspace root. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "path", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Relative file path (may contain slashes)" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "File path required or invalid" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "File not found" }
        }
      }
    },
    "/api/workspaces/{workspace_id}/tasks/{task_id}/conversation": {
      "get": {
        "summary": "Get task conversation",
        "description": "Returns the agent conversation for the task. Session is an implementation detail; the task stores session_id when run. Caller must own the workspace. Requires Bearer JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "created_at": { "type": "string" },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": { "type": "string" },
                          "content": { "type": "string" },
                          "tool_call_id": { "type": "string" },
                          "tool_calls": { "type": "array" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "task_id required" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Task or conversation not found" }
        }
      }
    }
  }
}
